# Dependencies
node_modules/

# Test / coverage output
coverage/

# Logs
*.log
npm-debug.log*

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local

# Terraform (keep .terraform.lock.hcl versioned - it pins provider versions)
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Terraform variable files may hold secrets - keep only the example
infra/*.tfvars
!infra/*.tfvars.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
